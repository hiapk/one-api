 // TracingMiddleware creates a middleware that records request tracing information
 func TracingMiddleware() gin.HandlerFunc {
 	return func(c *gin.Context) {
+		// Skip tracing if disabled in config
+		if !config.EnableTrace {
+			c.Next()
